{
  "expo": {
    "name": "Flux Financier",
    "slug": "financeflow",
    "owner": "ktataabdr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#1D4ED8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.financeflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Flux Financier utilise l'appareil photo pour photographier un chèque, une traite ou un justificatif de paiement.",
          "photosPermission": "Flux Financier accède à vos photos pour joindre un justificatif à un paiement.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://51.75.24.113:1334",
      "eas": {
        "projectId": "7805d063-8b78-4329-af74-146c6223237f"
      }
    }
  }
}
